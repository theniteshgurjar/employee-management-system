# ==========================================
# Employee Management System - .gitignore
# ==========================================

# Compiled Java class files & build directories
**/target/
*.class
*.jar
*.war
*.ear

# Eclipse & Adoptium
.metadata/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
nbactions.xml
nb-configuration.xml

# Visual Studio Code
.vscode/
*.code-workspace

# Node / React
frontend/node_modules/
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
application-secret.yml
application-secret.properties

# Logs
logs/
*.log

# Database files & Local PostgreSQL cluster
.pgdata/
pgdata/
*.pid

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
 
tools/
